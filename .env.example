SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_here

ADMIN_EMAIL=your_admin_email@gmail.com

DATABASE_URL=postgresql://postgres.xxxx:password@aws-x-ap-south-1.pooler.supabase.com:6543/postgres             #comment out for local SQLite

# Redis — local for development, Upstash for production
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_REDIS_URL=redis://localhost:6379/2

# Email (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_FRONTEND_API=https://your-clerk-app.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_...

# Supabase Storage (for resume uploads)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Groq (AI features)
GROQ_API_KEY=your_groq_api_key